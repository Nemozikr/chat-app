{
  "name": "chat-app",
  "private": true,
  "workspaces": ["server", "chat-client"],
  "version": "1.0.0",
  "scripts": {
    "server": "pnpm --filter server dev",
    "client": "pnpm --filter chat-client dev",
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "dotenv": "^16.5.0"
  }
}
